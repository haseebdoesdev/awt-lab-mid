# Copy to server/.env for local development (npm run dev).

NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/pulse
# Comma-separated list of allowed browser origins (Vite dev server).
CLIENT_ORIGIN=http://localhost:5173
# Public URL of the app, used in password-reset links (defaults to CLIENT_ORIGIN).
APP_URL=http://localhost:5173

# Required. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-secret-change-me-please
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Admin account created on startup if it doesn't exist.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@pulse.local
ADMIN_PASSWORD=admin12345

# Password-reset emails. Leave SMTP_HOST empty to print reset links in the server log instead.
# Any SMTP provider works, e.g. Gmail (smtp.gmail.com, 587, an app password), Brevo or Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Pulse Chat <no-reply@pulse.local>
