# Copy to server/.env for local development (npm run dev).

NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/pulse
# Comma-separated list of allowed browser origins (Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# Required. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-secret-change-me-please
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Admin account created on startup if it doesn't exist.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@pulse.local
ADMIN_PASSWORD=admin12345
