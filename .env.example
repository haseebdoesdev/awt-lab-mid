# Used by docker-compose.yml. Copy to .env and adjust.

# Required: secret used to sign JWT access tokens. Generate a strong one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=please-change-me-to-a-long-random-string

# Admin account created on first start (leave the password empty to skip).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@pulse.local
ADMIN_PASSWORD=admin12345

# Port the app is published on: http://localhost:8080
APP_PORT=8080

# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false
