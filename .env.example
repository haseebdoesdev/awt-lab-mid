# Used by docker-compose.yml. Copy to .env and adjust.

# Required: secret used to sign JWT access tokens. Generate a strong one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=please-change-me-to-a-long-random-string

# Admin account created on first start (leave the password empty to skip).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@pulse.local
ADMIN_PASSWORD=admin12345

# Port the app is published on: http://localhost:8080
APP_PORT=8080

# Public URL of the app, used in password-reset links (e.g. https://chat.example.com).
APP_URL=http://localhost:8080

# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false

# Password-reset emails. Leave SMTP_HOST empty to print reset links in the server log instead.
# Any SMTP provider works, e.g. Gmail (smtp.gmail.com, 587, an app password), Brevo or Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Pulse Chat <no-reply@pulse.local>
